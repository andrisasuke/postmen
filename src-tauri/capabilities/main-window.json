{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-window",
  "description": "Local PostMen shell only; no filesystem, shell, or HTTP access from the webview.",
  "windows": ["main"],
  "permissions": [
    "allow-bootstrap-app",
    "allow-load-workspace",
    "allow-list-workspaces",
    "allow-create-workspace",
    "allow-select-workspace",
    "allow-set-default-workspace",
    "allow-delete-workspace",
    "allow-create-collection",
    "allow-rename-collection",
    "allow-delete-collection",
    "allow-create-folder",
    "allow-update-folder",
    "allow-delete-folder",
    "allow-create-request",
    "allow-get-request",
    "allow-save-request",
    "allow-delete-request",
    "allow-reorder-items",
    "allow-save-environment",
    "allow-delete-environment",
    "allow-select-environment",
    "allow-save-session",
    "allow-pick-attachment",
    "allow-pick-collection-import",
    "allow-preview-collection-import",
    "allow-commit-collection-import",
    "allow-discard-collection-import",
    "allow-prepare-collection-export",
    "allow-pick-collection-export-directory",
    "allow-commit-collection-export",
    "allow-discard-collection-export",
    "allow-prepare-execution",
    "allow-execute-request",
    "allow-cancel-request",
    "allow-list-history",
    "allow-close-guard-ready",
    "allow-cancel-quit",
    "allow-finish-quit",
    "allow-start-titlebar-drag",
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:window:allow-start-dragging",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-internal-toggle-maximize",
    "core:window:allow-close",
    "core:window:allow-set-theme"
  ]
}
